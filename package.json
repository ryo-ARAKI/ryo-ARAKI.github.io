{
  "name": "ryo-araki-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Maintenance scripts for Ryo Araki's personal Jekyll site.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryo-ARAKI/ryo-ARAKI.github.io"
  },
  "keywords": [
    "jekyll",
    "github-pages",
    "personal-site"
  ],
  "author": "ARAKI Ryo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryo-ARAKI/ryo-ARAKI.github.io/issues"
  },
  "homepage": "https://ryo-araki.github.io",
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "plotly.js-dist-min": "^3.6.0"
  },
  "devDependencies": {
    "jslint": "^0.12.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
